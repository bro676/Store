# Server
PORT=3000
TRUST_PROXY=false
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_SSL=true
PUBLIC_BASE_URL=https://your-store.example
ADMIN_API_KEY=replace-with-a-long-random-secret

# Sham Cash API — verified contract from sybclint API docs
PAYMENTS_ENABLED=false
PAYMENT_CURRENCY=SYP
PAYMENT_ORDER_TTL_MINUTES=15
PAYMENT_MAX_AGE_MINUTES=15
PAYMENT_FUTURE_SKEW_SECONDS=90

# Use the exact base URL in the documentation. The server appends /v1/... routes.
SHAM_API_BASE_URL=https://apis-shamcash.com/api
SHAM_API_TOKEN=
# Exact wallet UUID (id) from GET /v1/wallets. It must be provider=shamcash and status=active.
SHAM_WALLET_ID=
SHAM_RECEIVER_LABEL=Nexa Store - Sham Cash
# Optional public receiver address fallback. The invoice identifier is authoritative on each order.
SHAM_RECEIVER_ADDRESS=
# ShamCash transaction datetime examples are timezone-less. Set this to the provider's local UTC offset.
# Syria local time at the documentation date is UTC+03:00.
SHAM_TIMEZONE_OFFSET_MINUTES=180
